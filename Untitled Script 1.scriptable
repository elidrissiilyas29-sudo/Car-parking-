  "name" : "Untitled Script 1",
  "script" : "\nconst playerId = \"MAYESTRO\";\n\nconst carIds = [\n  89, 62, 5, 150, 103, 51, 107, 251, 222, 248,\n  47, 132, 273, 168, 107, 123, 59, 128, 60, 13,\n  131, 131, 132, 237, 236, 137, 258, 178, 218, 187,\n  229, 150, 153, 154, 156, 157, 43, 195, 57, 217,\n  164, 88, 168, 5, 201, 178, 261, 123, 154, 157,\n  128, 234, 187, 231, 164, 191, 257, 195, 197, 103,\n  201, 82, 207, 205, 207, 70, 241, 245, 55, 217,\n  218, 222, 222, 241, 8, 154, 245, 248, 251, 257,\n  258, 261, 241, 8, 154, 245, 248, 251, 257, 258,\n  261, 264, 266, 270, 273, 197, 7, 31, 191, 86,\n  4, 40, 44, 43, 44, 45, 47, 156, 241, 5,\n  51, 153, 54, 55, 57, 137, 59, 60, 205, 62,\n  45, 7, 70, 4, 8, 82, 86, 88, 89\n];\n\nconst uniqueIds = [...new Set(carIds)];\n\nconst menu = new Alert();\nmenu.title = \"MAYESTRO CARS\";\nmenu.message =\n  \"Jugador: \" + playerId +\n  \"\\nEntradas: \" + carIds.length +\n  \"\\nIDs diferentes: \" + uniqueIds.length;\nmenu.addAction(\"Ver todos los IDs\");\nmenu.addAction(\"Buscar un ID\");\nmenu.addAction(\"Ver progreso\");\nmenu.addCancelAction(\"Salir\");\n\nconst option = await menu.presentSheet();\n\nif (option === 0) {\n  const list = new Alert();\n  list.title = \"Lista de coches\";\n  list.message = uniqueIds.join(\", \");\n  list.addAction(\"Aceptar\");\n  await list.presentAlert();\n\n} else if (option === 1) {\n  const search = new Alert();\n  search.title = \"Buscar coche\";\n  search.message = \"Escribe un ID numérico\";\n  search.addTextField(\"Ej. 89\");\n  search.addAction(\"Buscar\");\n  search.addCancelAction(\"Cancelar\");\n\n  if (await search.presentAlert() === 0) {\n    const id = Number(search.textFieldValue(0));\n    const result = new Alert();\n    result.title = \"Resultado\";\n\n    if (search.textFieldValue(0).trim() !== \"\" &&\n        Number.isInteger(id) && uniqueIds.includes(id)) {\n      result.message = \"El ID \" + id +\n        \" aparece en la lista.\";\n    } else {\n      result.message = \"No se encontró ese ID en la lista.\";\n    }\n\n    result.addAction(\"Aceptar\");\n    await result.presentAlert();\n  }\n\n} else if (option === 2) {\n  const progress = new Alert();\n  progress.title = \"Progreso\";\n  progress.message =\n    \"Entradas procesadas: \" + carIds.length +\n    \"\\nIDs únicos: \" + uniqueIds.length +\n    \"\\n\\nEsta versión solo organiza IDs. No modifica el juego.\";\n  progress.addAction(\"Aceptar\");\n  await progress.presentAlert();\n}",
  "share_sheet_inputs" : [

  ]
}